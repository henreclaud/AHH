# Copy this file to .env.staging and fill it in. .env.staging is git-ignored.
# Used only by scripts/staging.js — see STAGING.md.

# The TEST calendar's ID (Google Calendar → Settings → the TEST calendar →
# "Integrate calendar" → Calendar ID). Its name must contain TEST.
GOOGLE_CALENDAR_ID=

# The TEST spreadsheet's ID (the long part of its URL between /d/ and /edit).
# Its name must contain TEST.
GOOGLE_SHEET_ID=

# The same service-account JSON the live app uses (copy it from Render →
# Environment). Paste it on one line. Never share it in chat or email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Your own Gmail address. Test volunteers become you+adult@…, you+ya@… etc.,
# and every staff alert goes here instead of to AAH staff.
STAGING_EMAIL=

# Optional: lets the hourly job send reminder and change emails during tests.
# Use a Gmail app password for STAGING_EMAIL's account, not your real password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
